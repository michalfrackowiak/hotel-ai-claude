# Production environment variables
# Copy to .env.prod and fill in real values

# Django
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=your-super-secret-key-here-generate-with-openssl-rand-base64-32
ALLOWED_HOSTS=hotel-ai.example.com,www.hotel-ai.example.com

# Database
DB_NAME=hotel_ai
DB_USER=hotel_ai
DB_PASSWORD=strong-postgres-password-here
DB_HOST=db
DB_PORT=5432

# AI Providers
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_PROVIDER=openai
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_CREDENTIALS_FILE=/app/google-credentials.json

# OpenLine
OPENLINE_BASE_URL=https://your-openline-instance.com
OPENLINE_API_KEY=your-openline-api-key
OPENLINE_WEBHOOK_SECRET=your-openline-webhook-secret
OPENLINE_ALLOW_UNSIGNED_WEBHOOKS=0
OPENLINE_DEFAULT_STREAM_URL=wss://hotel-ai.example.com/voice/stream/
OPENLINE_VERIFY_TLS=1

# CORS/CSRF
CSRF_TRUSTED_ORIGINS=https://hotel-ai.example.com,https://www.hotel-ai.example.com